<script>
/* Interfaz compartida: avatar hexagonal y rangos (misma para la app y los juegos) */
(function(){
  var EMB={"xl": "data:image/webp;base64,", "weight": "data:image/webp;base64,", "creatine": "data:image/webp;base64,", "shaker": "data:image/webp;base64,", "gloves": "data:image/webp;base64,", "battery": "data:image/webp;base64,", "crystal": "data:image/webp;base64,"};
  var FR={green:'#00ff66',cyan:'#00e5ff',purple:'#c77dff',orange:'#ffbd45'},FRN={green:'Verde neón',cyan:'Cian',purple:'Púrpura',orange:'Naranja'};
  var RX=[0,100,300,700,1500,3000,5500,9000,14000,22000],RN=['RECLUTA','CABO','SARGENTO','SARGENTO MAYOR','TENIENTE','CAPITÁN','MAYOR','CORONEL','GENERAL','OLYMPUS'];
  var RK=[['bronze','c1'],['bronze','c2'],['bronze','c3'],['silver','c1s'],['silver','c2s'],['silver','c3s'],['gold','sc'],['gold','s3c'],['silver','wing'],['gold','top']];
  var MET={bronze:['#f0c9a0','#b87a4a','#6e4126'],silver:['#f4f8fb','#a9b6bf','#5d6a73'],gold:['#fff0b8','#d8a93f','#7d5a14']};
  function rankIdx(xp){var i=0;for(var k=0;k<RX.length;k++)if(xp>=RX[k])i=k;return i;}
  function level(xp){return Math.floor((xp||0)/100)+1;}
  function avatar(emb,fr,size){var c=FR[fr]||FR.green,src=EMB[emb]||EMB.xl;return '<span class="havw" style="--c:'+c+'"><span class="hav" style="--c:'+c+';--s:'+size+'px"><span class="hav-in"><img alt="" src="'+src+'"></span></span></span>';}
  function hp(cx,cy,r){var o=[];for(var k=0;k<6;k++){var a=(-90+60*k)*Math.PI/180;o.push((cx+r*Math.cos(a)).toFixed(1)+','+(cy+r*Math.sin(a)).toFixed(1));}return o.join(' ');}
  function star(cx,cy,r,f){var o=[];for(var k=0;k<10;k++){var rr=k%2?r*.42:r,a=(-90+36*k)*Math.PI/180;o.push((cx+rr*Math.cos(a)).toFixed(1)+','+(cy+rr*Math.sin(a)).toFixed(1));}return '<polygon points="'+o.join(' ')+'" fill="'+f+'"/>';}
  function chev(cx,cy){var w=13;return '<polygon points="'+(cx-w)+','+(cy+4)+' '+cx+','+(cy-5)+' '+(cx+w)+','+(cy+4)+' '+(cx+w)+','+(cy+10)+' '+cx+','+(cy+1)+' '+(cx-w)+','+(cy+10)+'" fill="url(#xl-chev)"/>';}
  function wings(cx,cy){var o='',s,i,L=[[-14,30],[-6,28],[2,24],[10,19]];for(s=-1;s<=1;s+=2)for(i=0;i<4;i++){var x0=cx+s*36,y0=cy+L[i][0],x1=cx+s*(36+L[i][1]),y1=y0-12+i*3;o+='<path d="M'+x0+','+y0+' Q'+(x0+x1)/2+','+(y0-10)+' '+x1+','+y1+' Q'+(x0+x1)/2+','+(y0+2)+' '+x0+','+(y0+7)+' Z" fill="url(#xl-gold)" stroke="#7a5a1a" stroke-width=".7"/>';}return o;}
  function rankSvg(i,size){
    var m=RK[i][0],k=RK[i][1],cx=64,cy=55,G='url(#xl-gold)',C='url(#xl-chev)',o='<svg viewBox="0 0 128 110" width="'+Math.round(size*1.28)+'" height="'+Math.round(size*1.1)+'" xmlns="http://www.w3.org/2000/svg" aria-label="'+RN[i]+'">';
    if(k==='wing'||k==='top')o+=wings(cx,cy);
    o+='<polygon points="'+hp(cx,cy,44)+'" fill="url(#xl-m_'+m+')" stroke="#2b2118" stroke-width="1.2"/><polygon points="'+hp(cx,cy,37)+'" fill="url(#xl-mi_'+m+')" stroke="rgba(0,0,0,.35)" stroke-width="1"/><polygon points="'+hp(cx,cy,30)+'" fill="#14181d" stroke="#2fe3ff" stroke-width="1.6" filter="url(#xl-glow)"/>';
    var E={c1:function(){return chev(cx,cy-2)},c2:function(){return chev(cx,cy-9)+chev(cx,cy+1)},c3:function(){return chev(cx,cy-14)+chev(cx,cy-5)+chev(cx,cy+4)},
      c1s:function(){return chev(cx,cy+2)+star(cx,cy-8,6,C)},c2s:function(){return chev(cx,cy-3)+chev(cx,cy+6)+star(cx,cy-12,5,C)},c3s:function(){return chev(cx,cy-8)+chev(cx,cy+1)+chev(cx,cy+10)+star(cx,cy-17,4.5,C)},
      sc:function(){return star(cx,cy-9,8,G)+chev(cx,cy+6)},s3c:function(){return star(cx,cy-14,6,G)+star(cx-9,cy-5,5.5,G)+star(cx+9,cy-5,5.5,G)+chev(cx,cy+8)},
      wing:function(){return star(cx,cy,13,G)},top:function(){return star(cx,cy-9,10,G)+star(cx-12,cy+7,5,G)+star(cx,cy+11,5,G)+star(cx+12,cy+7,5,G)}};
    return o+E[k]()+'</svg>';
  }
  var d=document.createElement('div');d.style.cssText='position:absolute;width:0;height:0;overflow:hidden';
  d.innerHTML='<svg width="0" height="0" aria-hidden="true"><defs><linearGradient id="xl-chev" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#b9c4cc"/></linearGradient><linearGradient id="xl-gold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff0b8"/><stop offset="1" stop-color="#c9982f"/></linearGradient>'+Object.keys(MET).map(function(k){var a=MET[k];return '<linearGradient id="xl-m_'+k+'" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="'+a[0]+'"/><stop offset=".55" stop-color="'+a[1]+'"/><stop offset="1" stop-color="'+a[2]+'"/></linearGradient><linearGradient id="xl-mi_'+k+'" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="'+a[0]+'"/><stop offset="1" stop-color="'+a[2]+'"/></linearGradient>';}).join('')+'<filter id="xl-glow"><feGaussianBlur stdDeviation="1.6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs></svg>';
  document.body.insertBefore(d,document.body.firstChild);
  window.XLUI={EMB:EMB,FR:FR,FRN:FRN,RX:RX,RN:RN,rankIdx:rankIdx,level:level,avatar:avatar,rankSvg:rankSvg};
})();
</script>

<script>
(function(){
  'use strict';
  var $=function(id){return document.getElementById(id)};
  var COLORS=['#00ff78','#00e5ff','#c77dff','#ffbd45','#ff3366'],COLS=8,ROWS=14,LIMIT=9,MISS_MAX=6;
  var cv=$('cv'),ctx=cv.getContext('2d'),W=0,H=0,R=20,RH=35,DPR=1,shift=0;
  var grid=[],cur=0,nxt=1,bullet=null,aim=-Math.PI/2,score=0,best=0,combo=1,miss=0,state='ready',parts=[],pops=[],last=0,raf=0,snd=true,ac=null,shake=0,level=1;
  try{best=parseInt(localStorage.getItem('xl_sh_best')||'0',10)||0;snd=localStorage.getItem('xl_sh_snd')!=='0';}catch(e){}
  function rowOdd(r){return ((r+shift)&1)===1;}
  function rowLen(r){return rowOdd(r)?COLS-1:COLS;}
  function cx(r,c){return (rowOdd(r)?2*R:R)+c*2*R;}
  function cy(r){return R+r*RH;}
  function rnd(n){return Math.floor(Math.random()*n);}
  function newRow(r){var a=[],n=rowLen(r);for(var c=0;c<n;c++)a.push(rnd(COLORS.length));return a;}
  function emptyRow(r){var a=[],n=rowLen(r);for(var c=0;c<n;c++)a.push(-1);return a;}
  function colorsInPlay(){var s={},r,c,o=[];for(r=0;r<ROWS;r++)for(c=0;c<grid[r].length;c++)if(grid[r][c]>=0)s[grid[r][c]]=1;for(var k in s)o.push(+k);return o.length?o:[0,1,2];}
  function pickColor(){var o=colorsInPlay();return o[rnd(o.length)];}
  function beep(f,d,t,v){if(!snd)return;try{ac=ac||new (window.AudioContext||window.webkitAudioContext)();var o=ac.createOscillator(),g=ac.createGain();o.type=t||'sine';o.frequency.value=f;g.gain.value=v||.05;o.connect(g);g.connect(ac.destination);o.start();g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+d);o.stop(ac.currentTime+d);}catch(e){}}
  function resize(){var w=$('stage').clientWidth;DPR=Math.min(2,window.devicePixelRatio||1);W=w;H=Math.round(w*1.3);R=W/(COLS*2);RH=R*1.732;cv.style.width=W+'px';cv.style.height=H+'px';cv.width=Math.round(W*DPR);cv.height=Math.round(H*DPR);}
  function fillRows(n){shift=0;grid=[];for(var r=0;r<ROWS;r++)grid.push(r<n?newRow(r):emptyRow(r));}
  function hud(){$('sc').textContent=score;$('bs').textContent=best;$('cb').textContent='×'+combo;}
  function newGame(){score=0;combo=1;miss=0;level=1;bullet=null;parts=[];pops=[];fillRows(5);cur=pickColor();nxt=pickColor();hud();}
  function start(){newGame();state='run';$('ov').classList.add('hide');last=performance.now();}
  function neighbors(r,c){
    var o=[[r,c-1],[r,c+1]],odd=rowOdd(r);
    [-1,1].forEach(function(d){var rr=r+d;if(odd){o.push([rr,c],[rr,c+1]);}else{o.push([rr,c-1],[rr,c]);}});
    return o.filter(function(p){return p[0]>=0&&p[0]<ROWS&&p[1]>=0&&p[1]<rowLen(p[0]);});
  }
  function flood(r,c){var col=grid[r][c],seen={},st=[[r,c]],out=[];seen[r*20+c]=1;while(st.length){var p=st.pop();out.push(p);neighbors(p[0],p[1]).forEach(function(q){var k=q[0]*20+q[1];if(!seen[k]&&grid[q[0]][q[1]]===col){seen[k]=1;st.push(q);}});}return out;}
  function floating(){
    var seen={},st=[],r,c,out=[];
    for(c=0;c<grid[0].length;c++)if(grid[0][c]>=0){seen[c]=1;st.push([0,c]);}
    while(st.length){var p=st.pop();neighbors(p[0],p[1]).forEach(function(q){var k=q[0]*20+q[1];if(!seen[k]&&grid[q[0]][q[1]]>=0){seen[k]=1;st.push(q);}});}
    for(r=0;r<ROWS;r++)for(c=0;c<grid[r].length;c++)if(grid[r][c]>=0&&!seen[r*20+c])out.push([r,c]);
    return out;
  }
  function burst(x,y,col,n){for(var i=0;i<n;i++){var a=Math.random()*6.283,s=60+Math.random()*180;parts.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-40,l:.5,c:col});}}
  function pop(x,y,t){pops.push({x:x,y:y,t:t,l:.8});}
  function shoot(){
    if(state!=='run'||bullet)return;
    var sp=W*2.6;bullet={x:W/2,y:H-R-8,vx:Math.cos(aim)*sp,vy:Math.sin(aim)*sp,c:cur};cur=nxt;nxt=pickColor();beep(520,.08,'triangle');
  }
  function hits(b){
    var r0=Math.floor(b.y/RH),r,c,lo=Math.max(0,r0-2),hi=Math.min(ROWS-1,r0+2);
    for(r=lo;r<=hi;r++)for(c=0;c<grid[r].length;c++)if(grid[r][c]>=0){var dx=cx(r,c)-b.x,dy=cy(r)-b.y;if(dx*dx+dy*dy<(1.8*R)*(1.8*R))return true;}
    return false;
  }
  function settle(){
    var b=bullet,r0=Math.round((b.y-R)/RH),best2=null,bd=1e9,r,c;bullet=null;
    for(r=Math.max(0,r0-1);r<=Math.min(ROWS-1,r0+1);r++)for(c=0;c<grid[r].length;c++){
      if(grid[r][c]>=0)continue;
      var att=(r===0)||neighbors(r,c).some(function(q){return grid[q[0]][q[1]]>=0;});if(!att)continue;
      var dx=cx(r,c)-b.x,dy=cy(r)-b.y,d=dx*dx+dy*dy;if(d<bd){bd=d;best2=[r,c];}
    }
    if(!best2){finish();return;}
    grid[best2[0]][best2[1]]=b.c;
    var grp=flood(best2[0],best2[1]);
    if(grp.length>=3){
      var gain=grp.length*10*combo;
      grp.forEach(function(p){burst(cx(p[0],p[1]),cy(p[0]),COLORS[grid[p[0]][p[1]]],6);grid[p[0]][p[1]]=-1;});
      var fl=floating();
      if(fl.length){gain+=fl.length*15*combo;fl.forEach(function(p){burst(cx(p[0],p[1]),cy(p[0]),COLORS[grid[p[0]][p[1]]],4);grid[p[0]][p[1]]=-1;});beep(260,.25,'sawtooth',.04);}
      score+=gain;pop(cx(best2[0],best2[1]),cy(best2[0]),'+'+gain);combo=Math.min(8,combo+1);miss=0;beep(680+combo*40,.12,'triangle');
      var any=false;for(r=0;r<ROWS&&!any;r++)for(c=0;c<grid[r].length;c++)if(grid[r][c]>=0){any=true;break;}
      if(!any){score+=500;level++;pop(W/2,H/2,'¡Nivel '+level+'! +500');var n=Math.min(7,4+Math.floor(level/2));fillRows(n);}
    }else{combo=1;miss++;shake=.12;beep(200,.1,'square',.03);if(miss>=MISS_MAX){miss=0;addRow();}}
    if(state==='run'&&best2[0]>=LIMIT)finish();
    hud();
  }
  function addRow(){
    shift^=1;grid.unshift(newRow(0));var out=grid.pop();
    if(out.some(function(v){return v>=0;}))return finish();
    for(var c=0;c<grid[LIMIT].length;c++)if(grid[LIMIT][c]>=0){finish();return;}
    beep(150,.2,'sawtooth',.04);
  }
  function finish(){
    if(state==='over')return;state='over';bullet=null;beep(110,.5,'sawtooth',.07);
    var nb=score>best;if(nb){best=score;try{localStorage.setItem('xl_sh_best',String(best));}catch(e){}}
    $('ovT').textContent=nb?'¡NUEVO RÉCORD!':'PARTIDA TERMINADA';$('ovI').textContent='Mejor puntuación: '+best;
    $('ovS').innerHTML='<div class="big">'+score+'</div>';$('ovB').textContent='Jugar otra vez';$('ov').classList.remove('hide');hud();
  }
  function update(dt){
    var i;
    if(state==='run'&&bullet){
      var steps=Math.max(1,Math.ceil(Math.hypot(bullet.vx,bullet.vy)*dt/(R*.45))),sdt=dt/steps;
      for(i=0;i<steps&&bullet;i++){
        bullet.x+=bullet.vx*sdt;bullet.y+=bullet.vy*sdt;
        if(bullet.x<R){bullet.x=R;bullet.vx=Math.abs(bullet.vx);}else if(bullet.x>W-R){bullet.x=W-R;bullet.vx=-Math.abs(bullet.vx);}
        if(bullet.y<=R||hits(bullet)){settle();break;}
      }
    }
    for(i=parts.length-1;i>=0;i--){var p=parts[i];p.l-=dt;if(p.l<=0){parts.splice(i,1);continue;}p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=500*dt;}
    for(i=pops.length-1;i>=0;i--){pops[i].l-=dt;pops[i].y-=40*dt;if(pops[i].l<=0)pops.splice(i,1);}
    shake=Math.max(0,shake-dt);
  }
  function gem(x,y,col,rad){
    var g=ctx.createRadialGradient(x-rad*.3,y-rad*.35,rad*.1,x,y,rad);g.addColorStop(0,'#fff');g.addColorStop(.25,col);g.addColorStop(1,'rgba(0,0,0,.55)');
    ctx.beginPath();ctx.arc(x,y,rad*.92,0,6.283);ctx.fillStyle=g;ctx.fill();ctx.lineWidth=2;ctx.strokeStyle=col;ctx.stroke();
    ctx.beginPath();ctx.arc(x-rad*.28,y-rad*.3,rad*.16,0,6.283);ctx.fillStyle='rgba(255,255,255,.75)';ctx.fill();
  }
  function draw(){
    ctx.setTransform(DPR,0,0,DPR,0,0);
    if(shake>0)ctx.translate((Math.random()-.5)*6*shake*8,(Math.random()-.5)*6*shake*8);
    ctx.clearRect(-20,-20,W+40,H+40);
    var ly=cy(LIMIT)-R*.2;ctx.strokeStyle='rgba(255,51,102,.55)';ctx.lineWidth=2;ctx.setLineDash([8,6]);ctx.beginPath();ctx.moveTo(0,ly);ctx.lineTo(W,ly);ctx.stroke();ctx.setLineDash([]);
    var r,c;for(r=0;r<ROWS;r++)for(c=0;c<grid[r].length;c++)if(grid[r][c]>=0)gem(cx(r,c),cy(r),COLORS[grid[r][c]],R);
    var px=W/2,py=H-R-8;
    if(state==='run'&&!bullet){
      ctx.strokeStyle='rgba(255,255,255,.5)';ctx.lineWidth=2;ctx.setLineDash([2,8]);ctx.lineCap='round';ctx.beginPath();ctx.moveTo(px,py);
      var dx=Math.cos(aim),dy=Math.sin(aim),len=H*.75,ex=px+dx*len,ey=py+dy*len;
      var wx=dx<0?R:W-R,t1=dx!==0?(wx-px)/dx:-1;
      if(t1>0&&t1<len){ctx.lineTo(px+dx*t1,py+dy*t1);var rem=len-t1;ctx.lineTo(px+dx*t1-dx*rem,py+dy*t1+dy*rem);}else ctx.lineTo(ex,ey);
      ctx.stroke();ctx.setLineDash([]);
    }
    if(bullet)gem(bullet.x,bullet.y,COLORS[bullet.c],R);
    ctx.save();ctx.translate(px,py);ctx.rotate(aim+Math.PI/2);ctx.fillStyle='#16304a';ctx.strokeStyle='#00e5ff';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-R*.45,0);ctx.lineTo(-R*.35,-R*1.3);ctx.lineTo(R*.35,-R*1.3);ctx.lineTo(R*.45,0);ctx.closePath();ctx.fill();ctx.stroke();ctx.restore();
    if(!bullet)gem(px,py,COLORS[cur],R*.95);
    gem(R*1.3,H-R*1.1,COLORS[nxt],R*.7);ctx.fillStyle='rgba(255,255,255,.55)';ctx.font='700 10px system-ui';ctx.textAlign='center';ctx.fillText('SIGUE',R*1.3,H-R*0.2);
    parts.forEach(function(p){ctx.globalAlpha=Math.max(0,p.l/.5);ctx.fillStyle=p.c;ctx.fillRect(p.x-2,p.y-2,4,4);});ctx.globalAlpha=1;
    ctx.font='700 16px system-ui';ctx.textAlign='center';pops.forEach(function(p){ctx.globalAlpha=Math.min(1,p.l/.4);ctx.fillStyle='#eafff2';ctx.fillText(p.t,p.x,p.y);});ctx.globalAlpha=1;
  }
  function loop(ts){raf=requestAnimationFrame(loop);var dt=Math.min(.033,(ts-(last||ts))/1000);last=ts;if(state==='run')update(dt);else update(0);draw();}
  function aimAt(e){var rc=cv.getBoundingClientRect(),x=e.clientX-rc.left,y=e.clientY-rc.top,dx=x-W/2,dy=y-(H-R-8);if(dy>-18)dy=-18;var a=Math.atan2(dy,dx);aim=Math.max(-Math.PI+.17,Math.min(-.17,a));}
  var downOnNext=false;
  cv.addEventListener('pointerdown',function(e){if(state!=='run')return;var rc=cv.getBoundingClientRect(),x=e.clientX-rc.left,y=e.clientY-rc.top;downOnNext=Math.hypot(x-R*1.3,y-(H-R*1.1))<R*1.1;if(!downOnNext)aimAt(e);try{cv.setPointerCapture(e.pointerId);}catch(x2){}e.preventDefault();});
  cv.addEventListener('pointermove',function(e){if(state==='run'&&!downOnNext)aimAt(e);});
  cv.addEventListener('pointerup',function(e){if(state!=='run')return;if(downOnNext){downOnNext=false;if(!bullet){var t=cur;cur=nxt;nxt=t;beep(400,.05);}return;}aimAt(e);shoot();});
  $('ovB').addEventListener('click',function(){start();});
  $('pa').addEventListener('click',function(){if(state==='run'){state='paused';$('ovT').textContent='PAUSA';$('ovI').textContent='Tu partida está en pausa.';$('ovS').innerHTML='';$('ovB').textContent='Continuar';$('ov').classList.remove('hide');$('ovB').onclick=function(){state='run';$('ov').classList.add('hide');last=performance.now();$('ovB').onclick=null;};}});
  function sndLbl(){$('so').textContent=snd?'🔊':'🔇';}
  $('so').addEventListener('click',function(){snd=!snd;try{localStorage.setItem('xl_sh_snd',snd?'1':'0');}catch(e){}sndLbl();if(snd)beep(660,.08);});sndLbl();
  document.addEventListener('visibilitychange',function(){if(document.hidden&&state==='run')$('pa').click();});
  window.addEventListener('resize',function(){resize();});
  function paintId(o){try{var xp=o.xp||0,ri=XLUI.rankIdx(xp);$('mAv').innerHTML=XLUI.avatar(o.emblem||'xl',o.frame||'green',50);$('mName').textContent=o.name||'JUGADOR';$('mRank').innerHTML=XLUI.rankSvg(ri,16)+' <small>'+XLUI.RN[ri]+'</small>';}catch(e){}}
  var cached=null;try{cached=JSON.parse(localStorage.getItem('xl_avatar')||'null');}catch(e){}paintId(cached||{emblem:'xl',frame:'green',name:'JUGADOR',xp:0});
  resize();fillRows(5);cur=pickColor();nxt=pickColor();hud();raf=requestAnimationFrame(loop);
})();
</script>
